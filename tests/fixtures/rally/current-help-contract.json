{
  "agy": {
    "provider": "agy",
    "modes": ["new", "resume"],
    "bypass_flags": ["--dangerously-skip-permissions"],
    "stream": "json",
    "example": "rally agy run --model flash --effort high --prompt 'Review changes.'"
  },
  "copilot": {
    "provider": "copilot",
    "modes": ["new", "resume"],
    "bypass_flags": ["--allow-all", "--no-ask-user"],
    "stream": "jsonl",
    "example": "rally copilot start --model auto --max-credits 30 --prompt-file task.txt"
  },
  "codex": {
    "provider": "codex",
    "modes": ["new", "resume"],
    "bypass_flags": ["--dangerously-bypass-approvals-and-sandbox"],
    "stream": "jsonl",
    "example": "rally codex start --effort low --prompt 'Review.'"
  },
  "claude": {
    "provider": "claude",
    "modes": ["new", "resume"],
    "bypass_flags": ["--dangerously-skip-permissions"],
    "stream": "jsonl",
    "example": "rally claude run --model haiku --effort low --prompt 'Review changes.'"
  }
}
